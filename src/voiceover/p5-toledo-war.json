{
  "name": "p5-toledo-war",
  "model": "gemini-3.8-flash-lite-tts",
  "totalSeconds": 69.585,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.12,
      "text": "This peninsula touches Wisconsin.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/01.wav",
      "durationInSeconds": 1.696,
      "tempo": 1.32,
      "hash": "e766c5be3000"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.12,
      "text": "It belongs to Michigan.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/02.wav",
      "durationInSeconds": 1.12,
      "tempo": 1.32,
      "hash": "e766c5be3000"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.3,
      "text": "Blame Toledo.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/03.wav",
      "durationInSeconds": 0.72,
      "tempo": 1.32,
      "hash": "e766c5be3000"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "In 1787, Congress drew a line straight east from the bottom of Lake Michigan.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/04.wav",
      "durationInSeconds": 4.485,
      "tempo": 1.32,
      "hash": "4071bafcf2d4"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "Michigan above, Ohio below.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/05.wav",
      "durationInSeconds": 1.704,
      "tempo": 1.32,
      "hash": "4071bafcf2d4"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.3,
      "text": "One problem: the maps of the day put the lake too far north.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/06.wav",
      "durationInSeconds": 2.846,
      "tempo": 1.32,
      "hash": "4071bafcf2d4"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.12,
      "text": "Ohio's survey put the line above the mouth of the Maumee River, and the town of Toledo.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/07.wav",
      "durationInSeconds": 3.804,
      "tempo": 1.32,
      "hash": "e3c651354122"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.12,
      "text": "Michigan's survey followed the 1787 law, and kept Toledo.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/08.wav",
      "durationInSeconds": 3.85,
      "tempo": 1.32,
      "hash": "e3c651354122"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.3,
      "text": "Between them: a strip up to eight miles wide.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/09.wav",
      "durationInSeconds": 2.358,
      "tempo": 1.32,
      "hash": "e3c651354122"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04a",
      "gapAfter": 0.12,
      "text": "By 1835, both sides were ready for war.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/10.wav",
      "durationInSeconds": 2.941,
      "tempo": 1.32,
      "hash": "31100ff24829"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04a",
      "gapAfter": 0.12,
      "text": "Michigan's governor was 23.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/11.wav",
      "durationInSeconds": 1.79,
      "tempo": 1.32,
      "hash": "31100ff24829"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04a",
      "gapAfter": 0.12,
      "text": "The Boy Governor.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/12.wav",
      "durationInSeconds": 0.799,
      "tempo": 1.32,
      "hash": "31100ff24829"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04b",
      "gapAfter": 0.12,
      "text": "Ohio set aside $300,000 for the fight.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/13.wav",
      "durationInSeconds": 3.18,
      "tempo": 1.32,
      "hash": "3fa681607a96"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04b",
      "gapAfter": 0.12,
      "text": "Michigan set aside $315,000.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/14.wav",
      "durationInSeconds": 2.546,
      "tempo": 1.32,
      "hash": "3fa681607a96"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04b",
      "gapAfter": 0.12,
      "text": "Its militia fired into the air and arrested nine surveyors.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/15.wav",
      "durationInSeconds": 3.492,
      "tempo": 1.32,
      "hash": "3fa681607a96"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04c",
      "gapAfter": 0.3,
      "text": "So who got hurt?",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/16.wav",
      "durationInSeconds": 1.086,
      "tempo": 1.32,
      "hash": "568d52e1678f"
    },
    {
      "id": "17",
      "scene": "s4",
      "take": "t04c",
      "gapAfter": 0.2,
      "text": "One sheriff.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/17.wav",
      "durationInSeconds": 0.659,
      "tempo": 1.32,
      "hash": "568d52e1678f"
    },
    {
      "id": "18",
      "scene": "s4",
      "take": "t04c",
      "gapAfter": 0.3,
      "text": "He was stabbed with a penknife, by a man named... Two Stickney.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/18.wav",
      "durationInSeconds": 3.069,
      "tempo": 1.32,
      "hash": "568d52e1678f"
    },
    {
      "id": "19",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.12,
      "text": "Then Congress made an offer: give Ohio the strip, take the western Upper Peninsula instead.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/19.wav",
      "durationInSeconds": 4.824,
      "tempo": 1.32,
      "hash": "ee25e5c034cf"
    },
    {
      "id": "20",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.12,
      "text": "Michigan said no.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/20.wav",
      "durationInSeconds": 0.765,
      "tempo": 1.32,
      "hash": "ee25e5c034cf"
    },
    {
      "id": "21",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.12,
      "text": "Then, in a freezing December, it said yes.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/21.wav",
      "durationInSeconds": 2.858,
      "tempo": 1.32,
      "hash": "ee25e5c034cf"
    },
    {
      "id": "22",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.3,
      "text": "Some say the Ohio State–Michigan rivalry started right here.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/22.wav",
      "durationInSeconds": 2.457,
      "tempo": 1.32,
      "hash": "ee25e5c034cf"
    },
    {
      "id": "23",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.3,
      "text": "And the consolation prize?",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/23.wav",
      "durationInSeconds": 1.263,
      "tempo": 1.32,
      "hash": "52fc3eac6546"
    },
    {
      "id": "24",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.4,
      "text": "Iron.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/24.wav",
      "durationInSeconds": 0.555,
      "tempo": 1.32,
      "hash": "52fc3eac6546"
    },
    {
      "id": "25",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "And copper.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/25.wav",
      "durationInSeconds": 0.556,
      "tempo": 1.32,
      "hash": "52fc3eac6546"
    },
    {
      "id": "26",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "In 1844, a surveyor named William Burt watched his compass needle go haywire.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/26.wav",
      "durationInSeconds": 4.352,
      "tempo": 1.32,
      "hash": "52fc3eac6546"
    },
    {
      "id": "27",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "The ground under him was full of iron.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/27.wav",
      "durationInSeconds": 1.581,
      "tempo": 1.32,
      "hash": "52fc3eac6546"
    },
    {
      "id": "28",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.3,
      "text": "Then, for forty years, Michigan mined more copper than any other state.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/28.wav",
      "durationInSeconds": 3.777,
      "tempo": 1.32,
      "hash": "52fc3eac6546"
    },
    {
      "id": "29",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.12,
      "text": "Ohio got Toledo.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/29.wav",
      "durationInSeconds": 1.221,
      "tempo": 1.32,
      "hash": "24c25817838a"
    },
    {
      "id": "30",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.3,
      "text": "Michigan got the copper.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/30.wav",
      "durationInSeconds": 1.262,
      "tempo": 1.32,
      "hash": "24c25817838a"
    },
    {
      "id": "31",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.12,
      "text": "The headline changes.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/31.wav",
      "durationInSeconds": 1.006,
      "tempo": 1.32,
      "hash": "24c25817838a"
    },
    {
      "id": "32",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.3,
      "text": "The map doesn't.",
      "voice": "Charon",
      "src": "voiceover/p5-toledo-war/32.wav",
      "durationInSeconds": 0.963,
      "tempo": 1.32,
      "hash": "24c25817838a"
    }
  ]
}
